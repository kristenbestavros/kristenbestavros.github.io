      margin: 0.9rem 0 0;
      max-width: 38rem;
    }

    /* --- the before/after pair --- */

    .pair {
      margin: 0;
      background: var(--raised);
      border: 1px solid var(--rule);
      padding: 1.4rem 1.4rem 0;
      max-width: 38rem;
    }

    .pair-head {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1rem;
      justify-content: space-between;
      padding-bottom: 1.1rem;
      border-bottom: 1px solid var(--rule);
    }

    .strat {
      color: var(--accent);
    }

    .turn {
      padding: 1.15rem 0;
      border-bottom: 1px solid var(--rule);
    }

    .pair > .turn:last-of-type {
      border-bottom: 0;
    }

    .who {
      margin-bottom: 0.45rem;
    }

    .turn.before .who {
      color: var(--flag);
    }

    .turn.after .who {
      color: var(--accent);
    }

    .say {
      margin: 0;
      font-size: 0.94rem;
      line-height: 1.55;
      max-width: none;
    }

    .withheld {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: var(--muted);
    }

    .annot {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--muted);
      margin: 0.6rem 0 0;
      padding-left: 0.75rem;
      border-left: 2px solid var(--accent);
      max-width: none;
    }

    .scores {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem 1.1rem;
      font-family: var(--font-mono);
      font-size: 0.67rem;
      letter-spacing: 0.04em;
      color: var(--muted);
      margin: 0.75rem 0 0;
      max-width: none;
    }

    .scores .bad {
      color: var(--flag);
    }

    .scores .good {
      color: var(--accent);
    }

    /* --- diagrams --- */

    .loop {
      margin: 3rem 0 0;
    }

    .loop svg,
    .chart svg {
      width: 100%;
      height: auto;
      max-width: 44rem;
      overflow: visible;
    }

    .loop rect {
      fill: var(--raised);
      stroke: var(--rule);
    }

    .loop .attacker rect {
      stroke: var(--flag);
    }

    .loop .defender rect {
      stroke: var(--accent);
    }

    .loop text {
      font-family: var(--font-body);
      font-size: 15px;
      fill: var(--ink);
      text-anchor: middle;
    }

    .loop .sub,
    .loop .edge {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.05em;
      fill: var(--muted);
    }

    .loop line,
    .loop path {
      stroke: var(--muted);
      fill: none;
      stroke-width: 1;
    }

    .chart {
      margin: 2.4rem 0 2rem;
    }

    .chart .grid line {
      stroke: var(--rule);
      stroke-width: 1;
    }

    .chart .grid .axis {
      stroke: var(--muted);
    }

    .chart text {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.05em;
      fill: var(--muted);
    }

    .chart .ylab text {
      text-anchor: end;
    }

    .chart .xlab text {
      text-anchor: middle;
    }

    .chart .line {
      fill: none;
      stroke-width: 2;
      stroke-linejoin: round;
    }

    .chart .comp {
      stroke: var(--mark);
    }

    .chart .qwen {
      stroke: var(--flag);
    }

    .chart .llama {
      stroke: var(--muted);
      stroke-dasharray: 4 3;
    }

    .chart .k-comp {
      fill: var(--mark);
    }

    .chart .k-qwen {
      fill: var(--flag);
    }

    .chart figcaption {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      line-height: 1.6;
      color: var(--muted);
      margin-top: 0.8rem;
      max-width: 38rem;
    }

    /* --- tables --- */

    .table-wrap {
      overflow-x: auto;
      margin: 2rem 0 2.4rem;
    }

    table {
      border-collapse: collapse;
      width: 100%;
      min-width: 32rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
    }

    th,
    td {
      text-align: right;
      padding: 0.5rem 0.7rem;
      border-bottom: 1px solid var(--rule);
      white-space: nowrap;
    }

    thead th {
      color: var(--muted);
      font-weight: 500;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-size: 0.64rem;
      border-bottom-color: var(--muted);
    }

    tbody th {
      color: var(--muted);
      font-weight: 400;
      text-align: left;
    }

    td.mono-cell,
    td.wrap {
      text-align: left;
    }

    td.wrap {
      white-space: normal;
      min-width: 16rem;
      color: var(--muted);
    }

    pre {
      background: var(--raised);
      border: 1px solid var(--rule);
      border-radius: 3px;
      padding: 0.9rem 1rem;
      overflow-x: auto;
      max-width: var(--measure);
    }

    code {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      line-height: 1.7;
      color: var(--ink);
    }
  </style>
</Base>
