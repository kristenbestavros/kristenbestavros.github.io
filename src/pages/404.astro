---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page doesn't exist.">
  <section class="section">
    <div>
      <h2 class="section-heading">404</h2>
      <div>
        <h1 class="page-title">That page isn't here</h1>
        <p class="lede intro">
          The link is either out of date or slightly wrong. The work is all one
          click away.
        </p>
        <p><a class="arrow-link" href="/work">Go to the work</a></p>
      </div>
    </div>
  </section>

  <style>
    .intro {
      margin: 1rem 0 1.8rem;
    }
  </style>
</Base>
